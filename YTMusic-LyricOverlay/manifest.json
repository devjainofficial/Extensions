{
  "manifest_version": 3,
  "name": "YTMusic Floating Lyrics Overlay",
  "version": "1.0.0",
  "description": "Always-on-top synchronized karaoke lyrics overlay for YouTube Music across virtual desktops.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://music.youtube.com/*",
    "https://lrclib.net/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "js": [
        "lyrics-service.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "pip/*",
        "icons/*"
      ],
      "matches": [
        "https://music.youtube.com/*"
      ]
    }
  ],
  "action": {
    "default_title": "YTMusic Floating Lyrics Overlay",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "popup/popup.html"
  }
}

{
  "manifest_version": 3,
  "name": "ChromaScope - Precision Pixel & Gradient Color Inspector",
  "version": "1.0.0",
  "description": "Inspect exact pixel colors and gradients with perceptual CIELAB naming, tone & shade nuance breakdown, and CSS generation.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "ChromaScope Color Inspector",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "scripts/background.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus",
    "clipboardWrite"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "scripts/color-names.js",
        "scripts/color-engine.js",
        "scripts/content.js"
      ],
      "css": [
        "styles/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+X",
        "windows": "Ctrl+Shift+X",
        "mac": "Command+Shift+X"
      },
      "description": "Open ChromaScope Extension Popup"
    },
    "toggle-inspector": {
      "suggested_key": {
        "default": "Alt+Shift+C",
        "windows": "Alt+Shift+C",
        "mac": "Alt+Shift+C"
      },
      "description": "Toggle In-Page Pixel & Hover Loupe Inspector"
    },
    "quick-eyedropper": {
      "suggested_key": {
        "default": "Alt+Shift+P",
        "windows": "Alt+Shift+P",
        "mac": "Alt+Shift+P"
      },
      "description": "Quick Screen EyeDropper"
    }
  }
}

{
  "manifest_version": 3,
  "name": "DashMorph - Drag & Drop Dashboard Customizer",
  "version": "1.0.0",
  "description": "Rearrange dashboard cards and widgets via drag-and-drop, preview custom layouts, and persist arrangements to localStorage for seamless auto-arrangement on revisit.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "DashMorph Dashboard Customizer",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "content/storage-manager.js",
        "content/card-detector.js",
        "content/drag-engine.js",
        "content/hud-ui.js",
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_end"
    }
  ],
  "commands": {
    "toggle_rearrange": {
      "suggested_key": {
        "default": "Alt+Shift+D",
        "windows": "Alt+Shift+D",
        "mac": "Alt+Shift+D"
      },
      "description": "Toggle DashMorph Rearrange Mode"
    }
  }
}
